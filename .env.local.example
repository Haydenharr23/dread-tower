# Copy this file to ".env.local" (same folder as package.json), then set your key.
# Only ".env.local" is loaded by Next.js — editing this example file alone does nothing.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: gate /api/ai (defaults to 1234). Use the same value for server + unlock UI, or only set NEXT_PUBLIC_*.
# NEXT_PUBLIC_AI_PASSKEY=your_secret_here
# AI_PASSKEY=your_secret_here
